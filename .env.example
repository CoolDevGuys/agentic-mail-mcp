GMAIL_MCP_GMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_MCP_GMAIL_OAUTH_CLIENT_SECRET=your-client-secret
GMAIL_MCP_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify
GMAIL_MCP_GMAIL_TOKEN_STORAGE_PATH=token.json
GMAIL_MCP_GMAIL_TOKEN_ENCRYPTION_KEY=your-encryption-key
GMAIL_MCP_DATABASE_URL=sqlite:///./gmail_mcp.db
GMAIL_MCP_DATABASE_DRIVER=sqlite
GMAIL_MCP_RAILGUARDS_ACCESS_LEVEL=owner
GMAIL_MCP_RAILGUARDS_ALLOWED_RECIPIENTS=
GMAIL_MCP_RAILGUARDS_BLOCKED_ACTIONS=
GMAIL_MCP_RAILGUARDS_RATE_LIMITS=
GMAIL_MCP_MCP_SERVER_NAME=Gmail-MCP
GMAIL_MCP_MCP_HOST=127.0.0.1
GMAIL_MCP_MCP_PORT=8080
GMAIL_MCP_LLM_PROVIDER=openai
GMAIL_MCP_LLM_MODEL=gpt-4
GMAIL_MCP_LLM_API_KEY=your-api-key
GMAIL_MCP_LLM_BASE_URL=
GMAIL_MCP_LLM_MODEL_PATH=
GMAIL_MCP_SEARCH_BACKEND=sqlite_vss
GMAIL_MCP_SEARCH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GMAIL_MCP_SEARCH_EMBEDDING_DIMENSION=384
GMAIL_MCP_NOTIFICATIONS_WEBHOOK_URL=
GMAIL_MCP_NOTIFICATIONS_REDIS_URL=
GMAIL_MCP_LOGGING_LEVEL=INFO
GMAIL_MCP_LOGGING_JSON_FORMAT=true
